{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "@cloudflare/workers-types"]
  },
  "include": [
    "src",
    "server",
    "scripts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "capacitor.config.ts"
  ]
}
