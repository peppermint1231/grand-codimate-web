{
  "name": "codimate",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-font.mjs",
    "predev": "node scripts/prepare-font.mjs",
    "dev": "vite --host 0.0.0.0",
    "api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "android:sync": "npm run build && cap sync android",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260917.1": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
