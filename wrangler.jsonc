{
  "name": "grand-codimate",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLINIC",
        "class_name": "Clinic"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Clinic"
      ]
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://grand-codimate.peppermint-3.workers.dev",
    "REQUIRE_ONEDRIVE": "true"
  },
  "observability": {
    "enabled": false
  }
}
